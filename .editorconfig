root = true

# LF everywhere (matches .gitattributes); 2-space indent matches the HTML/CSS/JS in src/.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
