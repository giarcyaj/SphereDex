# macOS
.DS_Store

# Firebase config (kept out of the public repo; CI writes it from the
# GOOGLE_SERVICES_JSON_BASE64 secret at build time, like the signing keystore).
app/google-services.json

# Android build machine state. local.properties holds the local SDK path (the
# header comment inside it says exactly that), .gradle/ is Gradle's per-project
# cache, and app/build/ is build output. None of it belongs in version control;
# tracking it kept git status permanently dirty on every build.
local.properties
.gradle/
app/build/

# Android Studio project state (same category as .gradle/): JDK names, Gradle
# migrations, device-streaming sessions and run configs are per-machine, and CI
# builds the APK without any of it. Untracked in the same pass as .gradle/.
.idea/

# Freebuff workspace metadata (local tool state).
.freebuff/

# Sieve/pipeline output. The scheduled workflow regenerates stage/ and POSTs it
# to /api/news, and uploads runs as artifacts, so the working copy stays local.
stage/

# Python tooling cache (tools/*.py)
__pycache__/

# Local scratch, previews and superseded store assets
tmp/
store-assets/google-play/_old-v1/

# Xcode user state & build artifacts (iOS)
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/**/DerivedData/
ios/**/build/

# Superseded native-SwiftUI iOS prototype (kept on disk, not tracked)
ios/Paldeck/

# Local secrets for the sieve tooling (tools/sieve.py writes SIEVE_API_KEY here).
# .env.example is a safe template and stays tracked.
.env
.env.*
!.env.example
