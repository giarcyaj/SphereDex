<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: notifications require an explicit runtime grant (requested on first launch). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="true"
        android:label="SphereDex"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SphereDex">

        <!-- Launched via the aliases below, so its launcher icon can be swapped for an unlocked sphere. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="SphereDex"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|fontScale|density|smallestScreenSize|locale|layoutDirection" />

        <!-- Launcher aliases: exactly one is enabled at a time. Default (classic / Pal blue) is on;
             each unlocked-sphere reward enables its own and disables the rest via PackageManager. -->
        <activity-alias
            android:name=".AliasDefault"
            android:enabled="true"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="SphereDex">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasMega"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_mega"
            android:roundIcon="@mipmap/ic_launcher_mega_round"
            android:label="SphereDex">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasGiga"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_giga"
            android:roundIcon="@mipmap/ic_launcher_giga_round"
            android:label="SphereDex">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasHyper"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_hyper"
            android:roundIcon="@mipmap/ic_launcher_hyper_round"
            android:label="SphereDex">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasUltra"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_ultra"
            android:roundIcon="@mipmap/ic_launcher_ultra_round"
            android:label="SphereDex">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasLegendary"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_legendary"
            android:roundIcon="@mipmap/ic_launcher_legendary_round"
            android:label="SphereDex">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SphereDex" />

        <!-- Firebase Cloud Messaging. Dormant until google-services.json is added. -->
        <service
            android:name=".SphereMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Defaults the system uses for notification-payload pushes delivered while backgrounded.
             The channel itself is still created in code (Push.ensureChannel). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="spheredex" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_spheredex" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
    </application>
</manifest>
