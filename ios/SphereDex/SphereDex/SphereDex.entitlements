<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- APNs environment. Xcode's App Store / TestFlight export promotes this to "production"
	     automatically via the distribution profile; the backend also falls back between the
	     production and sandbox APNs hosts, so device tokens from either build type deliver. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
